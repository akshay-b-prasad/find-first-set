# =============================================================================
# synth_pipeline.ys  —  Yosys synthesis script for ffs_pipeline
# =============================================================================

# 1. Read RTL
read_verilog -sv rtl/ffs_pipeline.sv

# 2. Elaborate, optimize, and technology-map to generic cells
synth -top ffs_pipeline -flatten

# 3. Clean up
clean

# 4. Cell statistics
tee -o reports/area_pipeline.txt stat

# 5. Longest topological path
tee -a reports/area_pipeline.txt ltp -noff

# 6. Write netlist
write_json reports/netlist_pipeline.json
write_verilog -noattr reports/netlist_pipeline.v
