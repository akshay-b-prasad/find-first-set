# =============================================================================
# synth_sequential.ys  —  Yosys synthesis script for ffs_sequential
# Target: generic cell mapping (synth internal ABC, no liberty required)
# =============================================================================

# 1. Read RTL
read_verilog -sv rtl/ffs_sequential.sv

# 2. Elaborate, optimize, and technology-map to generic cells
synth -top ffs_sequential -flatten

# 3. Clean up dangling wires
clean

# 4. Cell statistics (generic primitives: \, \, \, etc.)
tee -o reports/area_sequential.txt stat

# 5. Longest topological path (logic depth in cell levels, FFs excluded)
tee -a reports/area_sequential.txt ltp -noff

# 6. Write netlist
write_json reports/netlist_sequential.json
write_verilog -noattr reports/netlist_sequential.v
