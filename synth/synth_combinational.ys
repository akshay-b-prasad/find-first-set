# =============================================================================
# synth_combinational.ys  —  Yosys synthesis script for ffs_combinational
# =============================================================================

# 1. Read RTL (MODE=1: balanced binary mux tree — default)
read_verilog -sv rtl/ffs_combinational.sv

# 2. Elaborate, optimize, and technology-map to generic cells
synth -top ffs_combinational -flatten

# 3. Clean up
clean

# 4. Cell statistics
tee -o reports/area_combinational.txt stat

# 5. Longest topological path
tee -a reports/area_combinational.txt ltp -noff

# 6. Write netlist
write_json reports/netlist_combinational.json
write_verilog -noattr reports/netlist_combinational.v
